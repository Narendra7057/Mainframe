//BANKRECN JOB (ACCT01),'NIGHTLY RECON',CLASS=A,MSGCLASS=X
//*===================================================================*
//* JOB: BANKRECN - NIGHTLY TRANSACTION RECONCILIATION BATCH STREAM    *
//* PURPOSE: 6-STEP CORE & BANK CHANNEL RECONCILIATION PIPELINE       *
//*===================================================================*
//*
//* STEP 005: CLEAN UP PREVIOUS TEMPORARY WORK DATASETS
//STEP005  EXEC PGM=IEFBR14
//DEL01    DD DSN=BANK.PROD.TXNCORE.SORTED,
//            DISP=(MOD,DELETE),UNIT=SYSDA,SPACE=(TRK,(1,0))
//DEL02    DD DSN=BANK.PROD.TXNBNK.SORTED,
//            DISP=(MOD,DELETE),UNIT=SYSDA,SPACE=(TRK,(1,0))
//DEL03    DD DSN=BANK.PROD.TXNCORE.GOOD,
//            DISP=(MOD,DELETE),UNIT=SYSDA,SPACE=(TRK,(1,0))
//DEL04    DD DSN=BANK.PROD.TXNCORE.REJECT,
//            DISP=(MOD,DELETE),UNIT=SYSDA,SPACE=(TRK,(1,0))
//DEL05    DD DSN=BANK.PROD.RECON.RESULTS,
//            DISP=(MOD,DELETE),UNIT=SYSDA,SPACE=(TRK,(1,0))
//DEL06    DD DSN=BANK.PROD.RECON.CTLREC,
//            DISP=(MOD,DELETE),UNIT=SYSDA,SPACE=(TRK,(1,0))
//DEL07    DD DSN=BANK.PROD.DBLOAD.UNLOAD,
//            DISP=(MOD,DELETE),UNIT=SYSDA,SPACE=(TRK,(1,0))
//*
//* STEP 010: SORT CORE TRANSACTIONS BY ACCOUNT NO (1,12) + REF (13,16)
//STEP010  EXEC PGM=SORT
//SORTIN   DD DSN=BANK.PROD.CORETXN,DISP=SHR
//SORTOUT  DD DSN=BANK.PROD.TXNCORE.SORTED,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,2),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSOUT   DD SYSOUT=*
//SYSIN    DD *
  SORT FIELDS=(1,12,CH,A,13,16,CH,A)
/*
//*
//* STEP 020: SORT BANK CHANNEL TRANSACTIONS THE SAME WAY
//STEP020  EXEC PGM=SORT
//SORTIN   DD DSN=BANK.PROD.BANKTXN,DISP=SHR
//SORTOUT  DD DSN=BANK.PROD.TXNBNK.SORTED,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,2),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSOUT   DD SYSOUT=*
//SYSIN    DD *
  SORT FIELDS=(1,12,CH,A,13,16,CH,A)
/*
//*
//* STEP 030: COBOL TXNVALID - VALIDATE SCHEMA, DATES & FIELD TYPES
//STEP030  EXEC PGM=TXNVALID,COND=(8,LT)
//TXNIN    DD DSN=BANK.PROD.TXNCORE.SORTED,DISP=SHR
//TXNGOO   DD DSN=BANK.PROD.TXNCORE.GOOD,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,2),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//TXNREJ   DD DSN=BANK.PROD.TXNCORE.REJECT,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(2,1),RLSE),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=1200)
//SYSOUT   DD SYSOUT=*
//*
//* STEP 040: COBOL RECONCIL - DUAL MATCH-MERGE AND VSAM MASTER LOOKUP
//STEP040  EXEC PGM=RECONCIL,COND=(8,LT)
//TXNCORE  DD DSN=BANK.PROD.TXNCORE.GOOD,DISP=SHR
//TXNBNK   DD DSN=BANK.PROD.TXNBNK.SORTED,DISP=SHR
//ACCTMSTR DD DSN=BANK.PROD.ACCTMSTR,DISP=SHR
//RECONOUT DD DSN=BANK.PROD.RECON.RESULTS,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(10,5),RLSE),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=1200)
//CTLREC   DD DSN=BANK.PROD.RECON.CTLREC,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSOUT   DD SYSOUT=*
//*
//* STEP 050: COBOL RECLOAD - PREPARE SQLITE/DB2 AUDIT INGESTION STREAM
//STEP050  EXEC PGM=RECLOAD,COND=(8,LT)
//RECONIN  DD DSN=BANK.PROD.RECON.RESULTS,DISP=SHR
//DBLOAD   DD DSN=BANK.PROD.DBLOAD.UNLOAD,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,2),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=2000)
//SYSOUT   DD SYSOUT=*
//*
//* STEP 060: COBOL RECRPT - GENERATE GDG REPORTS (SUMMARY, MATCHED, EXCEPTIONS)
//STEP060  EXEC PGM=RECRPT,COND=(8,LT)
//RECONIN  DD DSN=BANK.PROD.RECON.RESULTS,DISP=SHR
//CTLIN    DD DSN=BANK.PROD.RECON.CTLREC,DISP=SHR
//REJIN    DD DSN=BANK.PROD.TXNCORE.REJECT,DISP=SHR
//RPTSUM   DD DSN=BANK.PROD.RECON.RPTSUM(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(2,1),RLSE),
//            DCB=(RECFM=FB,LRECL=132,BLKSIZE=1320)
//RPTMAT   DD DSN=BANK.PROD.RECON.RPTMAT(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,2),RLSE),
//            DCB=(RECFM=FB,LRECL=132,BLKSIZE=1320)
//RPTEXC   DD DSN=BANK.PROD.RECON.RPTEXC(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,2),RLSE),
//            DCB=(RECFM=FB,LRECL=132,BLKSIZE=1320)
//RPTREJ   DD DSN=BANK.PROD.RECON.RPTREJ(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(2,1),RLSE),
//            DCB=(RECFM=FB,LRECL=132,BLKSIZE=1320)
//SYSOUT   DD SYSOUT=*
//*
//* STEP 070: IEBGENER - COPY SUMMARY REPORT TO SYSOUT SPOOL
//STEP070  EXEC PGM=IEBGENER,COND=(8,LT)
//SYSUT1   DD DSN=BANK.PROD.RECON.RPTSUM(0),DISP=SHR
//SYSUT2   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//*
//* STEP 080: CONTROL-TOTAL AUDIT TIE-OUT CHECK
//STEP080  EXEC PGM=CTLCHECK,COND=(8,LT)
//CTLIN    DD DSN=BANK.PROD.RECON.CTLREC,DISP=SHR
//SYSOUT   DD SYSOUT=*
//
