//DEMO01   JOB (ACCT01),'DEMO DATASET JOB',CLASS=A,MSGCLASS=X
//*===================================================================*
//* SAMPLE JCL: ALLOCATE, POPULATE & CATALOG A SEQUENTIAL DATASET    *
//* YOU CAN UPLOAD THIS FILE DIRECTLY IN THE "RUN JOBS" WEB TAB.      *
//*===================================================================*
//*
//* STEP 1: CLEAN UP PRE-EXISTING DATASET (DISP=MOD,DELETE)
//STEP010  EXEC PGM=IEFBR14
//CLEANUP  DD DSN=BANK.USER.DEMO.PS01,
//            DISP=(MOD,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1,0))
//*
//* STEP 2: ALLOCATE A NEW FIXED-BLOCK SEQUENTIAL DATASET
//STEP020  EXEC PGM=IEFBR14
//ALLOCDS  DD DSN=BANK.USER.DEMO.PS01,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(2,1),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//*
//* STEP 3: COPY IN-STREAM BANK TRANSACTION RECORDS INTO DATASET
//STEP030  EXEC PGM=IEBGENER
//SYSUT1   DD *
ACCT10002001TXN20261020000120261020DR000000015000USDATM0JOHN DOE       
ACCT10002002TXN20261020000220261020CR000000032550USDPOS0JANE SMITH     
ACCT10002003TXN20261020000320261020DR000000007525USDWEB0ACME CORP      
ACCT10002004TXN20261020000420261020CR000000120000USDACH0GLOBAL LOGISTICS
/*
//SYSUT2   DD DSN=BANK.USER.DEMO.PS01,DISP=MOD
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//*
//* STEP 4: IDCAMS LISTCAT TO INSPECT THE CATALOGUED DATASET
//STEP040  EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  LISTCAT ALL
/*
//
